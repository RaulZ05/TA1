{
  "name": "llampayec",
  "version": "1.0.0",
  "private": true,
  "description": "Llampayec Panadería Artesanal - Frontend estático + API Node.js (Express + SQLite)",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint js server scripts tests",
    "lint:css": "stylelint \"css/**/*.css\"",
    "test": "node --test tests/",
    "start": "npm --prefix server run start",
    "seed": "npm --prefix server run seed",
    "docker:build": "docker build -t llampayec .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "stylelint": "^16.11.0"
  },
  "engines": {
    "node": ">=18"
  }
}